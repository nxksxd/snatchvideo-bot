# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789

# Optional SOCKS5 proxy for Rutube downloads
# Format: socks5://user:password@host:port
RUTUBE_PROXY=

# Netscape-format cookies.txt for YouTube. Highly recommended on datacenter
# IPs — without cookies, YouTube returns "Sign in to confirm you're not a bot"
# for many videos. Cookies are paired in code with player_client=tv_embedded
# and remote_components=ejs:github (yt-dlp's EJS challenge solver), which
# together bypass YouTube's current SABR-only routing for the web client.
#
# Export Netscape-format cookies from a browser logged into a DEDICATED bot
# Google account (do NOT use your primary account — cookies are bearer
# credentials and leaking them grants account access). Store the file with
# mode 0600 outside of the repo. Leave empty to disable, but expect frequent
# YouTube failures in that case.
YOUTUBE_COOKIES_FILE=

# Netscape-format cookies.txt for Instagram. Highly recommended on datacenter
# IPs — Instagram blocks anonymous access with "Requested content is not
# available, rate-limit reached or login required" for most reels and
# stories. Export from a browser logged into a DEDICATED bot Instagram
# account (do NOT use your primary account). Store with mode 0600 outside of
# the repo. Leave empty to disable, but expect Instagram URLs to fail.
INSTAGRAM_COOKIES_FILE=

# Logging
LOG_LEVEL=INFO

# Local Bot API (self-hosted telegram-bot-api). Enable when you need to send
# files larger than the 50 MB limit of the official API.
USE_LOCAL_BOT_API=false
TELEGRAM_API_BASE=http://localhost:8081

# Limits and timeouts
MAX_FILE_SIZE_MB=2000
SLOW_DOWNLOAD_SPEED=102400
SLOW_DOWNLOAD_WINDOW=45
DOWNLOAD_TIMEOUT=600
SESSION_TIMEOUT=1200
DOWNLOAD_SEMAPHORE_LIMIT=3
CLEANUP_INTERVAL=1800
TEMP_FILE_TTL=1800
STATS_CACHE_TTL=300

# Optional custom paths
# TEMP_DIR=/tmp/video_download_bot
# STATS_DB_PATH=/path/to/stats.db
